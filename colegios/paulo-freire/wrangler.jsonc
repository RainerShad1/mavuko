{
  // Configuración de Cloudflare Workers para el sistema del colegio
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colegiopaulofreire",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/webhook", "/panel", "/media/*", "/f/*"]
  },
  // 12:00 UTC = 8:00 a. m. en República Dominicana
  "triggers": { "crons": ["0 12 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "WA_PHONE_ID": "1444174328779901",
    "GRAPH_VERSION": "v23.0"
  }
  // Secretos (se configuran en Cloudflare, nunca en este archivo):
  //   DATABASE_URL, WA_TOKEN, WA_VERIFY_TOKEN, WA_APP_SECRET
  // Opcionales: WA_PLANTILLA_AVISO, WA_PLANTILLA_IDIOMA
  // Redes sociales: FB_PAGE_ID, FB_PAGE_TOKEN (secreto), IG_USER_ID
}
